%TEMPLATE_MODE HTML
# ------------------------------------------------------------
%INPUT
<p th:utext="${#conversions.convert('payload', '[Lorg.thymeleaf.templateengine.conversion.conversion8.ConversionGadget8;')}">NOT ALLOWED</p>
# ------------------------------------------------------------
%EXCEPTION org.thymeleaf.exceptions.TemplateProcessingException
%EXCEPTION_MESSAGE_PATTERN (.*)\Qcannot be used as a target for type conversion operations (#conversions) in a restricted expression execution context\E(.*)
