%TEMPLATE_MODE HTML
# ------------------------------------------------------------
%INPUT
<p th:text="${#conversions.convert('/tmp/thymeleaf-conversion8', '[Ljava.io.File;')}">NOT ALLOWED</p>
# ------------------------------------------------------------
%EXCEPTION org.thymeleaf.exceptions.TemplateProcessingException
%EXCEPTION_MESSAGE_PATTERN (.*)\Qcannot be used as a target for type conversion operations (#conversions): access to this type is forbidden in expressions\E(.*)
